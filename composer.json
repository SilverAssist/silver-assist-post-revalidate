{
  "name": "silver-assist/post-revalidate",
  "description": "WordPress plugin for automatic post and category cache revalidation",
  "type": "wordpress-plugin",
  "license": "PolyForm-Noncommercial-1.0.0",
  "authors": [
    {
      "name": "Silver Assist",
      "homepage": "http://silverassist.com/"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.2",
    "composer/installers": "^2.0",
    "silverassist/wp-github-updater": "^1.3",
    "silverassist/wp-plugin-kernel": "^1.0",
    "silverassist/wp-settings-hub": "^1.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^7.1",
    "php-stubs/wordpress-tests-stubs": "^7.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "silverassist/wp-coding-standards": "^1.0",
    "squizlabs/php_codesniffer": "^3.7 || ^4.0",
    "szepeviktor/phpstan-wordpress": "^1.3 || ^2.0",
    "wp-coding-standards/wpcs": "^3.0",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "RevalidatePosts\\": "Includes/"
    }
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "phpunit": "phpunit",
    "test": [
      "@phpcs",
      "@phpstan",
      "@phpunit"
    ],
    "setup-hooks": "git config core.hooksPath .githooks",
    "post-install-cmd": "@setup-hooks",
    "post-update-cmd": "@setup-hooks"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2.0"
    }
  }
}
